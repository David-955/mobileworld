{% extends 'base.html.twig' %}

{% block title %}Mobile World : Profil{% endblock %}

{% block body %}
    <h1><a href="{{ path('app_accueil') }}">Mobile World</a></h1>
    
    <h2>Mon profil</h2>
    <img src="{{ personnalisation.avatar }}" alt="Avatar"></img>
    <p>{{ personnalisation.presentation }}</p>

    <form action="{{ path('app_profil_update_avatar') }}" method="post" enctype="multipart/form-data">
        <label for="avatar">Changer l'avatar :</label>
        <input type="file" id="avatar" name="avatar">
        <button type="submit">Mettre à jour l'avatar</button>
    </form>

    <form action="{{ path('app_profil_update_presentation') }}" method="post">
        <label for="presentation">Personnaliser la présentation :</label>
        <textarea id="presentation" name="presentation">{{ personnalisation ? personnalisation.presentation : '' }}</textarea>
        <button type="submit">Mettre à jour mon message de présentation</button>
    </form>
{% endblock %}
