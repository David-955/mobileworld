{% extends 'base.html.twig' %}

{% block title %}Mobile World : Profil{% endblock %}

{% block body %}
    <h1><a href="{{ path('app_accueil') }}">Mobile World</a></h1>
    
    <h2>Profil</h2>
    {# image par défaut si avatar est NULL #}
    <img src="{{ personnalisation.avatar ? personnalisation.avatar : '/images/profils/defaut.png' }}" alt="Avatar"></img>
    <p>{{ personnalisation.presentation ? personnalisation.presentation : 'Bonjour, ceci est un message de présentation par défaut.' }}</p>
    <br>

    <form action="{{ path('app_profil_update') }}" method="post" enctype="multipart/form-data">
        <label for="avatar">Changer l'avatar :</label>
        <input type="file" id="avatar" name="avatar">
        <button type="submit">Mettre à jour l'avatar (ça marche pas)</button>
    </form>

    <form action="{{ path('app_profil_update') }}" method="post">
        <label for="presentation">Personnaliser la présentation :</label>
        <textarea id="presentation" name="presentation">{{ personnalisation.presentation }}</textarea>
        <button type="submit">Mettre à jour mon message de présentation</button>
    </form>
{% endblock %}
