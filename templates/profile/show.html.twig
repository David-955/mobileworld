{% extends 'base.html.twig' %}

{% block title %}Profil de {{ personnalisation.pseudo }}{% endblock %}

{% block content %}

    <h1>Profil de {{ personnalisation.pseudo }}</h1>
    <img src="{{ asset(personnalisation.avatar) }}" alt="Avatar de {{ personnalisation.pseudo }}">
    <p>Message de présentation : {{ personnalisation.presentation }}</p>
{% endblock %}