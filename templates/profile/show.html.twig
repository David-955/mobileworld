{% extends 'base.html.twig' %}

{% block title %}Profil de
	{{ personnalisation.pseudo }}
{% endblock %}

{% block content %}

	<h1>Profil de <em>{{ personnalisation.pseudo }}</em></h1>

	<section class="container-vert">
		<section class="container-blanc">
			<img src="{{ asset(personnalisation.avatar) }}" alt="Avatar de {{ personnalisation.pseudo }}">
			<p>Message de présentation : <em>{{ personnalisation.presentation }}</em></p>
			<br>
			{# Bouton retour visible seulement si on est connecté #}
			{% if app.user %}
				<p><a href="{{ path('app_profil') }}" class="btn-retour">Personnalisation de mon profil ici</a></p>
			{% endif %}
		</section>
	</section>
{% endblock %}
