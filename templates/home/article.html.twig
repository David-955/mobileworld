{% extends 'base.html.twig' %}

{% block title %}Mobile World : {{ article.title }}{% endblock %}

{% block content %}
	{# fil d'Ariane #}
    <p style="margin-left: 10%;">
        <a href="{{ path('app_home') }}">Accueil</a> &gt; {{ title }}
    </p>

    <section class="article-container">
        <header class="article-title">
            <h1>{{ article.title }}</h1>
        </header>

        <section class="article-content">
            {% if article.description %}
                <p><em>{{ article.description }}</em></p>
            {% endif %}

            {% if article.urlToImage %}
                <img src="{{ article.urlToImage }}" alt="{{ article.title }}" class="article-image">
            {% endif %}

            <div class="full-content">
                {{ article.htmlContent | raw }}
            </div>

            <p class="source-article">
                <a href="{{ article.url }}" target="_blank">
                    Source originale : {{ article.source.name }} — {{ article.publishedAt|date('d/m/Y H:i') }}
                </a>
            </p>
        </section>

        <section class="container-comments">
            <h2>Commentaires</h2>

            {% for commentaire in pagination %}
                <article class="list-comments">
                    <div>
                        <a href="{{ path('app_profile_pseudo', {pseudo: commentaire.utilisateur.personnalisation.pseudo}) }}">
                            <img src="{{ commentaire.utilisateur.personnalisation.avatar }}" alt="Avatar de {{ commentaire.utilisateur.personnalisation.pseudo }}" class="comments-img">
                        </a>
                    </div>
                    <div class="comments-column2">
                        <em><strong>Posté par
                            <a href="{{ path('app_profile_pseudo', {pseudo: commentaire.utilisateur.personnalisation.pseudo}) }}">
                                {{ commentaire.utilisateur.personnalisation.pseudo }}</a></strong>, le {{ commentaire.date|date('d/m/Y') }} à {{ commentaire.date|date('H:i') }}</em>
                        <p>{{ commentaire.contenu }}</p>
                    </div>
                </article>
				<br>
            {% else %}
                <p><em>Aucun commentaire pour le moment.</em></p>
            {% endfor %}

            {{ knp_pagination_render(pagination) }}
			<br>

			{# Formulaire d'ajout de commentaire #}
            {% if app.user %}
                <h2>Ajouter un commentaire</h2>

                <section class="add-comments">
                    {% form_theme form "form/champs.html.twig" %}

                    {{ form_start(form, {'attr': {'class': 'comment-form'}}) }}

                    {{ form_row(form.contenu, {
                        label: 'Exprimez-vous :',
                        attr: {
                            placeholder: 'Entrez votre commentaire ici (1500 caractères maximum)',
                            class: 'form-control',
                            maxlength: 1500
                        },
                        label_attr: { class: 'form-label' }
                    }) }}
					<br>
                    <p><button class="btn-submit" type="submit">Ajouter un commentaire</button></p>

                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </section>
            {% else %}
                <p><em>Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour poster un commentaire.</em></p>
            {% endif %}
			<br>
			<p><a href="{{ path('app_home') }}" class="btn-submit">Retour aux news</a></p>

        </section>
    </section>
{% endblock %}
