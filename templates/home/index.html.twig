{% extends 'base.html.twig' %}

{% block title %}Mobile World : Les actualités{% endblock %}

{% block content %}
<section class="main">

	{# Afficher les messages flash #}
	{% for label, messages in app.flashes %}
		{% for message in messages %}
			<div class="alert alert-{{ label }}" style="width: 100%; text-align: center;">{{ message }}</div>
		{% endfor %}
	{% endfor %}

	<h1>Les dernières news</h1>
	<ul id="news-container">
		{% for article in pagination.items %}
			{% if article.title is not empty %}
				{% set encodedTitle = article.title|url_encode %}
				{% if '/' not in encodedTitle %}
					<li class="news-article">
						<article class="news-image-container">
							<a href="{{ path('app_article', {'title': encodedTitle}) }}" target="_blank">
								{% set original = article.urlToImage %}
								{% set clean_url = original|replace({'https://': '', 'http://': ''}) %}
								{% set proxy_url = 'https://images.weserv.nl/?url=' ~ clean_url ~ '&w=426&h=240&output=webp' %}
								<img 
									src="{{ proxy_url }}"
									onerror="this.onerror=null;this.src='{{ original }}'" 
									alt="{{ article.title }}" 
									width="426" height="240"
									{% if not loop.first %}loading="lazy"{% endif %}
									decoding="async"
									fetchpriority="{{ loop.first ? 'high' : 'low' }}"
									class="news-image"
								/>
							</a>
						</article>
						<article class="news-content">
							<p style="font-size: 0.8em; color: #666;">
								{% if article.publishedAt %}
									{{ article.publishedAt|date('d/m/Y') }}
								{% else %}
									{{ '' }}
								{% endif %}
							</p>
							<a href="{{ path('app_article', {'title': encodedTitle}) }}" target="_blank" style="text-decoration: none;">
								<h2 class="news-title">{{ article.title }}</h2>
								<p class="news-description">{{ article.description }}</p>
							</a>
							<a href="{{ path('app_article', {'title': encodedTitle}) }}" target="_blank" class="news-readmore">Lire la suite...</a>
						</article>
					</li>
				{% endif %}
			{% endif %}
		{% endfor %}
	</ul>

	<div class="pagination">
		{{ knp_pagination_render(pagination) }}
	</div>
</section>
{% endblock %}
