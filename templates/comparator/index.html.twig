{% extends 'base.html.twig' %}

{% block title %}Mobile World : Comparateur de smartphones
{% endblock %}

{% block content %}
	<h1>Notre comparateur d'appareils mobiles</h1>

	<section class="comparator-container-green">
		<section class="comparator-container-white">
			<!-- Première colonne -->
			<div class="comparator-column1">
				<h3>Sélection 1</h3>
				<form method="GET" action="{{ path('app_comparator') }}">
					<label for="marque1">Choisissez une marque:</label>
					{# class="form-select" = bootstrap #}
					<select class="form-select" name="marque1" id="marque1" onchange="this.form.submit()">
						<option value="">-- Sélectionnez une marque --</option>
						{% for marque in marques %}
							<option value="{{ marque }}" {% if marque == selectedMarque1 %} selected {% endif %}>{{ marque | capitalize }}</option>
						{% endfor %}
					</select>
					<input type="hidden" name="marque2" value="{{ selectedMarque2 }}">
					<input type="hidden" name="modelId2" value="{{ selectedModelId2 }}">
				</form>

				{% if models1 is not empty %}
					<form method="GET" action="{{ path('app_comparator') }}">
						<input type="hidden" name="marque1" value="{{ selectedMarque1 }}">
						<label for="model1">Choisissez un modèle:</label>
						<select class="form-select" name="modelId1" id="model1" onchange="this.form.submit()">
							<option value="">-- Sélectionnez un modèle --</option>
							{% for model in models1 %}
								<option value="{{ model.id }}" {% if model.id == selectedModelId1 %} selected {% endif %}>{{ model.name }}</option>
							{% endfor %}
						</select>
						<input type="hidden" name="marque2" value="{{ selectedMarque2 }}">
						<input type="hidden" name="modelId2" value="{{ selectedModelId2 }}">
					</form>
				{% endif %}

				{% if modelData1 %}
					<div class="specs">
						{# Affichage des caractéristiques du modèle sélectionné #}
						{# On utilise le filtre replace pour remplacer les points par des sauts de ligne #}
						{# raw pour éviter que Twig n'échappe le HTML #}
						<h2>{{ modelData1.name }}</h2>
						<img src="{{ modelData1.img }}" alt="{{ modelData1.name }}">
						<p>{{ modelData1.description|replace({'. ': '.<br>'})|raw }}</p>
					</div>
				{% endif %}
			</div>

			<!-- Deuxième colonne -->
			<div class="comparator-column2">
				<h3>Sélection 2</h3>
				<form method="GET" action="{{ path('app_comparator') }}">
					<label for="marque2">Choisissez une marque:</label>
					<select class="form-select" name="marque2" id="marque2" onchange="this.form.submit()">
						<option value="">-- Sélectionnez une marque --</option>
						{% for marque in marques %}
							<option value="{{ marque }}" {% if marque == selectedMarque2 %} selected {% endif %}>{{ marque | capitalize }}</option>
						{% endfor %}
					</select>
					<input type="hidden" name="marque1" value="{{ selectedMarque1 }}">
					<input type="hidden" name="modelId1" value="{{ selectedModelId1 }}">
				</form>

				{% if models2 is not empty %}
					<form method="GET" action="{{ path('app_comparator') }}">
						<input type="hidden" name="marque2" value="{{ selectedMarque2 }}">
						<label for="model2">Choisissez un modèle:</label>
						<select class="form-select" name="modelId2" id="model2" onchange="this.form.submit()">
							<option value="">-- Sélectionnez un modèle --</option>
							{% for model in models2 %}
								<option value="{{ model.id }}" {% if model.id == selectedModelId2 %} selected {% endif %}>{{ model.name }}</option>
							{% endfor %}
						</select>
						<input type="hidden" name="marque1" value="{{ selectedMarque1 }}">
						<input type="hidden" name="modelId1" value="{{ selectedModelId1 }}">
					</form>
				{% endif %}

				{% if modelData2 %}
					<div class="specs">
						<h2>{{ modelData2.name }}</h2>
						<img src="{{ modelData2.img }}" alt="{{ modelData2.name }}">
						<p>{{ modelData2.description|replace({'. ': '.<br>'})|raw }}</p>
					</div>
				{% endif %}
			</div>
		</section>
	</section>
{% endblock %}
