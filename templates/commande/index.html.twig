{% extends 'base.html.twig' %}

{% block title %}Mobile World : Passer commande
{% endblock %}

{% block content %}
	<h1>Passer commande</h1>

	<section class="container-vert">
		<section class="container-blanc">
			<p style="margin-left: 15px; text-align: left;">
				<a href="{{ path('app_panier') }}">Panier</a>
				> 
																                Passer commande
			</p>

			{% if panier|length > 0 %}
				<h2>1. Récapitulatif</h2>
				<!-- Tableau de récapitulatif -->
				<table class="table">
					<thead>
						<tr>
							<th></th>
							<th>Désignation</th>
							<th>Quantité</th>
							<th>Prix</th>
							<th>Sous-total</th>
						</tr>
					</thead>
					<tbody>
						{% for item in panier %}
							<tr>
								<td><img src="{{ asset('images/produits/' ~ item.product.image) }}" alt="Image de {{ item.product.nom }}" class="zoomable-image" data-modal="image-modal" style="width: 100px; border-radius: 8px;"></td>
								<td data-label="Nom du produit: ">{{ item.product.nom }}</td>
								<td data-label="Quantité: ">{{ item.quantity }}</td>
								<td data-label="Prix unitaire: ">{{ item.product.prix }}€</td>
								<td data-label="Total: ">{{ item.total }}€</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				<p>La livraison est
					<strong>offerte</strong>
					pour toute commande pour fêter l'ouverture de notre site !</p>

				<h3>
					<strong>Montant total TTC :
						{{ total }}€</strong>
				</h3>
			{% else %}
				<p>Votre panier est vide.</p>
			{% endif %}
			<hr>

			<!-- Formulaire global -->
			<h2>2. Adresse de Livraison</h2>
			<form method="post" action="{{ path('app_commande') }}">
				<label for="nom">* Nom :</label>
				<input type="text" id="nom" name="nom" class="form-control" placeholder="Entrez votre nom" maxlength="100" required>
				<br>
				<label for="prenom">* Prénom :</label>
				<input type="text" id="prenom" name="prenom" class="form-control" placeholder="Entrez votre prénom" maxlength="100" required>
				<br>
				<label for="adresse">* Adresse :</label>
				<input type="text" id="adresse" name="adresse" class="form-control" placeholder="Entrez votre adresse" maxlength="100" required>
				<br>
				<label for="ville">* Ville :</label>
				<input type="text" id="ville" name="ville" class="form-control" placeholder="Entrez votre ville" maxlength="100" required>
				<br>
				<label for="codePostal">* Code Postal :</label>
				<input type="text" id="codePostal" name="codePostal" class="form-control" placeholder="Entrez votre code postal" maxlength="5" required>
				<br>
				<label for="tel">* Téléphone :</label>
				<input type="text" id="tel" name="tel" class="form-control" placeholder="Entrez votre numéro de téléphone" maxlength="10" required>
				<br>

				<button type="submit" class="btn-submit">Valider la commande</button>
				<br><br>
				<small class="required-note">{{ "(*) Tous les champs sont obligatoire" }}</small>
				<br>
				<small class="required-note">{{ "Prix TTC, TVA appliquée sur la base du pays : France (métropolitaine)" }}</small>
			</form>
		</section>
	</section>
	<div id="image-modal" class="modal">
		<span class="close">&times;</span>
		<img class="modal-content" id="modal-image">
	</div>
{% endblock %}
