{% extends 'base.html.twig' %}

{% block title %}Mobile World : Passer commande
{% endblock %}

{% block content %}


	<h1>Passer commande</h1>

	<section class="container-vert">
		<section class="container-blanc">

			<p style="margin-left: 15px; text-align: left;">
				<a href="{{ path('app_panier') }}">Panier</a>
				> Passer commande
			</p>

			{# Afficher les messages flash #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="flash-message alert alert-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}

			{% if panier|length > 0 %}
				<h2>1. Récapitulatif</h2>
				<!-- Tableau de récapitulatif -->
				<table class="table">
					<thead>
						<tr>
							<th></th>
							<th>Désignation</th>
							<th>Quantité</th>
							<th>Prix</th>
							<th>Sous-total</th>
						</tr>
					</thead>
					<tbody>
						{% for item in panier %}
							<tr>
								<td><img src="{{ asset('images/produits/' ~ item.product.image) }}" alt="Image de {{ item.product.nom }}" class="zoomable-image" data-modal="image-modal" style="width: 100px; border-radius: 8px;"></td>
								<td data-label="Nom du produit: ">{{ item.product.nom }}</td>
								<td data-label="Quantité: ">{{ item.quantity }}</td>
								<td data-label="Prix unitaire: ">{{ item.product.prix }}€</td>
								<td data-label="Total: ">{{ item.total }}€</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				<p>La livraison est
					<strong>offerte</strong>
					pour toute commande pour fêter l'ouverture de notre site !</p>

				<h3>
					<strong>Montant total TTC :
						{{ total }}€</strong>
				</h3>
			{% else %}
				<p>Votre panier est vide.</p>
			{% endif %}
			<hr>

			{% if formAdresse is not empty and formAdresse.vars.errors|length > 0 %}
				<div class="alert alert-danger">
					Veuillez corriger les erreurs ci-dessous.
				</div>
			{% endif %}

			<!-- Formulaire global -->
			<h2>2. Adresse de Livraison</h2>

			{# Personnalisation des messages d'erreurs #}
			{% form_theme formAdresse "form/champs.html.twig" %}

			{{ form_start(formAdresse) }}
			<div class="form-group">
				{{ form_row(formAdresse.nom) }}
			</div>
			<div class="form-group">
				{{ form_row(formAdresse.prenom) }}
			</div>
			<div class="form-group">
				{{ form_row(formAdresse.adresse) }}
			</div>
			<div class="form-group">
				{{ form_row(formAdresse.ville) }}
			</div>
			<div class="form-group">
				{{ form_row(formAdresse.codePostal) }}
			</div>
			<div class="form-group">
				{{ form_row(formAdresse.tel) }}
			</div>

			<h2>3. Payer ma commande</h2>
			<p>Veuillez cliquer sur le bouton ci-dessous pour effectuer votre paiement sécurisé via notre page de paiement.</p>

			<button type="submit" class="btn-submit">Valider l'adresse et payer</button>
			{{ form_end(formAdresse) }}

			{# <button type="submit" class="btn-submit">Page de paiement</button> #}
			<br><br>
			<small class="required-note">{{ "(*) Tous les champs sont obligatoire" }}</small>
			<br>
			<small class="required-note">{{ "Prix TTC, TVA appliquée sur la base du pays : France (métropolitaine)" }}</small>
		</form>
	</section>
</section>
<div id="image-modal" class="modal">
	<span class="close">&times;</span>
	<img class="modal-content" id="modal-image">
</div>{% endblock %}
