<!DOCTYPE html>
<html>
	<head>
		<title>Mobile World : Confirmation de commande n°
			{{ numero }}</title>
	</head>
	<body>
		<h1>Bonjour
			{{ user.prenom }}
			{{ user.nom }},</h1>
		<p>Votre commande a bien été passée ! Voici les détails :</p>

		<h2>Détails de la commande :</h2>
		<p>Numéro de commande :
			{{ numero }}</p>
		<p>
			<strong>Date de la commande :</strong>
			{{ date|date('d/m/Y H:i') }}</p>

		<ul>
			{% for item in panier %}
				<li>
					{{ item.product.nom }}
					- Quantité :
					{{ item.quantity }}
					- Prix unitaire :
					{{ item.product.prix }}
					€
				</li>
			{% endfor %}
		</ul>

		<p>
			<strong>Montant total TTC :
				{{ total }}
				€</strong>
		</p>

		<p>Merci pour votre achat !</p>
		<p>Toute l'équipe de Mobile World.</p>
		{# Lien pour télécharger le récapitulatif de commande #}
		<a href="https://127.0.0.1:8000/mes-commandes">
			Voir mes commandes
		</a>
		<br><br>
	</body>
</html>
