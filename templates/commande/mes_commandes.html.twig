{% extends 'base.html.twig' %}

{% block title %}
	Mobile World : Mes commandes
{% endblock %}

{% block content %}
	<h1>Mes commandes</h1>

	<section class="container-vert">
		<section
			class="container-blanc">
			{# Afficher les messages flash #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="flash-message alert alert-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}

			{% if commandesGroupedByNumero|length == 0 %}
				<p>Vous n'avez passé aucune commande pour le moment.</p>
				<p>
					<a href="{{ path('app_boutique') }}" class="btn-submit">Accéder à la boutique</a>
				</p>
			{% else %}
				<ul class="liste-commande1">
					{% for numeroCommande, groupe in commandesGroupedByNumero %}
						<li class="liste-commande2">
							<div class="commande-header">
								<p>
									<strong>Numéro de commande :</strong>
									{{ numeroCommande }}
								</p>
								<p>
									<strong>Date :</strong>
									{{ groupe.date|date('d/m/Y') }} à {{ groupe.date|date('H:i') }}
								</p>

								<address class="adresse-livraison" style="overflow: auto;">
									<strong>Adresse de livraison :</strong><br>
									{{ groupe.produits[0].nom }}
									{{ groupe.produits[0].prenom }}<br>
									{{ groupe.produits[0].adresse }}<br>
									{{ groupe.produits[0].codePostal }}
									{{ groupe.produits[0].ville }}<br>
									Tél :
									{{ groupe.produits[0].tel }}
								</address>
							</div>

							{% for commande in groupe.produits %}
								<div class="produit-item">
									<strong>Produit :</strong>
									{{ commande.produit.nom }}<br>
									<strong>ID Produit :</strong>
									{{ commande.produit.id }}<br>
									<strong>Quantité :</strong>
									{{ commande.quantite }}<br>
									<strong>Prix unitaire :</strong>
									{{ commande.produit.prix }}
									€<br>
									<strong>Sous-total :</strong>
									{{ commande.produit.prix * commande.quantite }}
									€<br>

									{# Affichage de l'image du produit #}
									<img src="{{ asset('images/produits/' ~ commande.produit.image) }}" alt="Image de {{ commande.produit.nom }}" class="zoomable-image" data-modal="image-modal" style="width: 100px; border-radius: 8px; margin: 10px"><br>

									{# Affichage du statut de la commande (TOUJOURS visible) #}
									<p><em><strong>Statut :</strong>
										{{ commande.statut }}</em></p>

									{% if commande.statut != 'Produit annulé par le client' %}
										<a href="{{ path('app_commande_annuler', { 'numero': numeroCommande, 'produitId': commande.produit.id, '_csrf_token': csrf_token('annuler_commande') }) }}" class="btn-submit" onclick="return confirm('Êtes-vous sûr de vouloir annuler ce produit ?');">
											Annuler ce produit
										</a>
									{% endif %}
									<br><br>
								</div>
							{% endfor %}

							{# Calcul du total TTC de la commande entière #}
							{% set totalCommande = groupe.produits|map(p => p.produit.prix * p.quantite)|reduce((a, b) => a + b) %}
							<h2>
								<strong>Total TTC de la commande :</strong>
								{{ totalCommande }}
								€
							</h2>
							<br>

							{# Lien pour télécharger le récapitulatif de commande #}
							{% set produitsNonAnnules = groupe.produits|filter(p => p.statut != 'Produit annulé par le client') %}

							{% if produitsNonAnnules|length > 0 %}
								<a href="{{ path('app_commande_pdf', {'numero': numeroCommande, '_csrf_token': csrf_token('generate_pdf') }) }}" class="btn-submit">
									Télécharger le récapitulatif de commande
								</a>
								<br><br>
							{% else %}
								<em>Tous les produits de cette commande ont été annulés.</em>
								<br><br>
							{% endif %}
						</li>
					{% endfor %}
				</ul>
			{% endif %}

			<div class="pagination">
				{{ knp_pagination_render(pagination) }}
			</div>

			<br>
			<p>
				<a href="{{ path('app_profil') }}" class="btn-submit">Retour vers mon profil</a>
			</p>
			<br>
			<p>
				<a href="{{ path('app_accueil') }}" class="btn-submit">Accéder à l'accueil</a>
			</p>
		</section>
	</section>

	<!-- Modal image -->
	<div id="image-modal" class="modal">
		<span class="close">&times;</span>
		<img class="modal-content" id="modal-image" alt="">
	</div>
{% endblock %}
