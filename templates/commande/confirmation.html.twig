{% extends 'base.html.twig' %}

{% block title %}Mobile World : Confirmation de commande{% endblock %}

{% block content %}
    <section class="container-vert">
        <section class="container-blanc">
            <h1>Confirmation de votre commande</h1>
            <p>Votre commande a été passée avec succès !</p>

            {# Afficher le numéro de commande une seule fois #}
            {# Comme toutes les commandes partagent le même numéro, il suffit d'afficher celui du premier élément #}
            <h2>Détails de la commande numéro <u>{{ commandes[0].numero }}</u> :</h2>
            <p><strong>Date de la commande :</strong> {{ date|date('d/m/Y H:i') }}</p>

            {% for commande in commandes %}
                <p class="liste-confirmation">
                    {{ commande.produit.nom }} - Quantité : {{ commande.quantite }} - Prix unitaire : {{ commande.produit.prix }} €
                </p>
            {% endfor %}

            <p><strong>Montant total TTC : {{ total }} €</strong></p>
            <p><a href="{{ path('app_accueil') }}" class="btn-submit">Retour à l'accueil</a></p>
        </section>
    </section>
{% endblock %}