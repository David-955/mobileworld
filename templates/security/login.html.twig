{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page de connexion
{% endblock %}

{% block content %}
	<h1>Connexion</h1>

	<section class="container-vert">
		<section
			class="container-blanc">
			{# Affichage des messages flash #}
			<div class="flash-messages">
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert alert-{{ label }}">{{ message }}</div>
					{% endfor %}
				{% endfor %}
			</div>
			
			<p>
				<strong>Content de vous revoir !</strong>
			</p>
			<p>
				<a href="{{ path('app_register') }}">
					<strong>Vous n’avez pas de compte ? Cliquez ici pour vous inscrire.</strong>
				</a>
			</p>
			<br>
			<p>
				<a href="{{ path('app_forgot_password') }}">
					<strong>Mot de passe oublié ?</strong>
				</a>
			</p>

			<form
				method="post">
				{# Affichage des erreurs d'authentification #}
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{% if app.user %}
					{# Si déjà connecté, on redirige la personne sur la page d'accueil #}
					<script type="text/javascript">
						window.location.href = "{{ path('app_accueil') }}";
					</script>
				{% endif %}

				<div class="form-group">
					<label for="username">Votre Email :</label>
				</div>
				<div class="form-group">
					<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="Entrez votre adresse Email" required>
				</div>

				<div class="form-group">
					<label for="password">Votre mot de passe :</label>
				</div>
				<div class="form-group">
					<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Entrez votre mot de passe" required>
				</div>

				<div class="form-group">
					<input type="checkbox" name="_remember_me" checked>
					<label for="_remember_me">Rester connecté</label>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
				<button class="btn-submit" type="submit">Connexion</button>
			</form>
		</section>
	</section>
{% endblock %}
