{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page de connexion
{% endblock %}

{% block content %}
	<h1>Connexion</h1>
	
	<section
		class="container-vert">
		<section class="container-blanc">
			<p>
				<strong>Content de vous revoir !</strong>
			</p>
			<p>
				<a href="{{ path('app_register') }}"><strong>Vous n’avez pas de compte ? Cliquez ici pour vous inscrire.</strong></a>
			</p>
			<br>

			<form method="post">
			
				{# affichage des erreurs #}
				{# exemple si on se trompe : "Invalid credentials" #}
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{% if app.user %}
					{# si déjà connecté, on redirige la personne sur la page d'accueil #}
					<script type="text/javascript">
						window.location.href = "{{ path('app_accueil') }}";
					</script>
				{% endif %}

				<div class="form-group">
					<label for="username">Votre Email :
					</label>
				</div>

				<div class="form-group">
					<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="Entrez votre adresse Email" required>
				</div>

				<br>

				<div class="form-group">
					<label for="password">Votre mot de passe :
					</label>
				</div>

				<div class="form-group">
					<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Entrez votre mot de passe" required>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<button class="btn-submit" type="submit">
					Connexion
				</button>
			</form>
		</section>
	</section>

{% endblock %}


{#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}
