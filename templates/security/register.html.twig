{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page d'inscription
{% endblock %}

{% block content %}
	<h1>Inscription</h1>

	<section class="container-vert">
		<section
			class="container-blanc">
			{# Afficher les messages flash #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="flash-message alert alert-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}
			
			<p>
				<strong>Bienvenue !</strong>
			</p>

			<p>
				<strong>L’inscription vous permettra de commenter ainsi que de pouvoir faire des achats.</p>
			</p>
		</strong>
		<p>
			<a href="{{ path('app_login') }}">
				<strong>Vous possédez déjà un compte ? Connectez-vous en cliquant ici.</strong>
			</a>
		</p>
		<br>


		{{ form_errors(registrationForm) }}
		{{ form_start(registrationForm, {'attr': {'class': 'form-container'}}) }}

		{# réutilisation de .form-group pour avoir de l'espacement #}
		<div class="form-group">
			{{ form_label(registrationForm.email, '* Votre adresse Email : ', {'label_attr': {'class': 'form-label'}}) }}
			{# je reprends .form-control pour reprendre le style des champs à remplir #}
			{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre adresse Email'}}) }}
		</div>

		<div class="form-group">
			{{ form_label(registrationForm.plainPassword.first, '* Choisir un mot de passe : ', {'label_attr': {'class': 'form-label'}}) }}
			{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Entrez un mot de passe'}}) }}
		</div>

		<div class="form-group">
			{{ form_label(registrationForm.plainPassword.second, '* Confirmez le mot de passe : ', {'label_attr': {'class': 'form-label'}}) }}
			{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le mot de passe'}}) }}
		</div>
		<div class="form-group">
			{{ form_row(registrationForm.agreeTerms, {
            label: "* J’accepte les conditions générales d’utilisation et la politique de confidentialité..."
        }) }}
		</div>

		<button type="submit" class="btn-submit">M'inscrire !</button>
		<br><br>
		<small class="required-note">{{ "(*) Tous les champs sont obligatoire" }}</small>

		{{ form_end(registrationForm) }}
	</section>
</section>{% endblock %}
