{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page d'inscription{% endblock %}

{% block body %}
	<h1>
		<a href="{{ path('app_accueil') }}">Mobile World</a>
	</h1>
    <h2>Inscription</h2>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email, {
            label: '* Votre adresse Email : '
        }) }}
        {{ form_row(registrationForm.plainPassword.first, {
            label: '* Choisir un mot de passe : '
        }) }}
        {{ form_row(registrationForm.plainPassword.second, {
            label: '* Confirmez le mot de passe : '
        }) }}
        {{ form_row(registrationForm.agreeTerms, {
            label: '* J’accepte les conditions générales d’utilisation et la politique de confidentialité'
        }) }}

        <button type="submit" class="btn">M'inscrire !</button>
        <br>
        {{ "Obligatoire lorsqu’il y a une étoile (*)" }}
    
    {{ form_end(registrationForm) }}

    <a href="{{ path('app_login') }}">Vous voulez plutôt vous connecter ?</a>
{% endblock %}
