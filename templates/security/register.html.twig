{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page d'inscription
{% endblock %}

{% block content %}
	<h1>Inscription</h1>

	<section class="container-green">
		<section
			class="container-white">
			{# Afficher les messages flash #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="flash-message alert alert-{{ label }}">{{ message }}</div>
				{% endfor %}
			{% endfor %}

			<p>
				<strong>Bienvenue !</strong>
			</p>
			<p>L’inscription vous permettra de commenter ainsi que de pouvoir faire des achats.</p>
			<p>
				<a href="{{ path('app_login') }}">
					<strong>Vous possédez déjà un compte ? Connectez-vous en cliquant ici.</strong>
				</a>
			</p>
			<p>
				<a href="{{ path('app_verification_pending') }}">
					<strong>Renvoyer le lien de confirmation.</strong>
				</a>
			</p>
			<br>

			{# Personnalisation des messages d'erreurs #}
			{% form_theme form "form/champs.html.twig" %}
			{# Formulaire avec affichage automatique des erreurs #}
			{{ form_start(form, {'attr': {'class': 'form-container'}}) }}

			{{ form_row(form.email, {
                label: "* Votre adresse Email :",
                attr: { placeholder: "Entrez votre adresse Email", class: "form-control" },
                label_attr: { class: "form-label" }
            }) }}

			<br><br>

			{{ form_row(form.plainPassword.first, {
                label: "* Choisir un mot de passe (au moins 6 caractères dont 1 majuscule et 1 chiffre) :",
                attr: { placeholder: "Entrez un mot de passe", class: "form-control" },
                label_attr: { class: "form-label" }
            }) }}

			<br>

			{{ form_row(form.plainPassword.second, {
                label: "* Confirmez le mot de passe :",
                attr: { placeholder: "Confirmez le mot de passe", class: "form-control" },
                label_attr: { class: "form-label" }
            }) }}

			<br>

			{{ form_row(form.agreeTerms, {
                label: "* J’accepte les conditions générales d’utilisation et la politique de confidentialité...",
                label_attr: { class: "form-check-label" }
            }) }}

			<br>

			<button type="submit" class="btn-submit">M'inscrire !</button>
			<br><br>
			<small class="required-note">{{ "(*) Tous les champs sont obligatoires" }}</small>

			{{ form_end(form) }}
		</section>
	</section>
{% endblock %}
