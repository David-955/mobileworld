{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page d'inscription
{% endblock %}

{% block content %}
	<h1>Inscription</h1>

	{# 1er border-radius #}
	<section
		class="register-container-vert">
		{# 2eme border-radius #}
		<section class="register-container-blanc">
			<p><strong>Bienvenue !</strong></p>
			<p>
				<strong>L’inscription vous permettra de commenter ainsi que de pouvoir faire des achats.</p>
			</p>
		</strong>
		<p>
			<a href="{{ path('app_login') }}">
				<strong>Vous possédez déjà un compte ? Connectez-vous en cliquant ici.</strong>
			</a>
		</p>


		{{ form_errors(registrationForm) }}

		{{ form_start(registrationForm) }}
		{{ form_row(registrationForm.email, {
            label: '* Votre adresse Email : '
        }) }}
		{{ form_row(registrationForm.plainPassword.first, {
            label: '* Choisir un mot de passe : '
        }) }}
		{{ form_row(registrationForm.plainPassword.second, {
            label: '* Confirmez le mot de passe : '
        }) }}
		{{ form_row(registrationForm.agreeTerms, {
            label: '* J’accepte les conditions générales d’utilisation et la politique de confidentialité'
        }) }}

		<button type="submit" class="btn">M'inscrire !</button>
		<br>
		{{ "(*) Tous les champs sont obligatoire" }}

		{{ form_end(registrationForm) }}
	</section>
</section>{% endblock %}
