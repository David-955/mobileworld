{% extends 'base.html.twig' %}

{% block title %}Mobile World - Modifier le mot de passe{% endblock %}

{% block content %}
<section class="container-green">
    <section class="container-white">

        {# Afficher les messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <h1>Modifier le mot de passe</h1>

        {# Formulaire pour saisir le nouveau mot de passe #}
        {% form_theme form "form/champs.html.twig" %}
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.plainPassword, 'Nouveau mot de passe (au moins 6 caractères dont 1 majuscule et 1 chiffre) :', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.plainPassword) }}
                {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre nouveau mot de passe', 'required': 'required'}}) }}
            </div>
            <br>
            <div class="form-group">
                {{ form_label(form.confirmPassword, 'Confirmez le nouveau mot de passe : ', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_errors(form.confirmPassword) }}
                {{ form_widget(form.confirmPassword, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez votre mot de passe', 'required': 'required'}}) }}
            </div>
            <br>
            <button type="submit" class="btn-submit">Réinitialiser</button>
        {{ form_end(form) }}

    </section>
</section>
{% endblock %}
