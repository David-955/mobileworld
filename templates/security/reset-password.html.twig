{% extends 'base.html.twig' %}

{% block title %}Mobile World - Réinitialiser le Mot de Passe
{% endblock %}

{% block content %}
    <section class="container-vert">
        <section class="container-blanc">
            <h1>Réinitialiser le Mot de Passe</h1>

            {# Afficher les messages flash #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} mt-3">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {# Formulaire pour saisir le nouveau mot de passe #}
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.plainPassword, 'Nouveau Mot de Passe : ', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre nouveau mot de passe', 'required': 'required'}}) }}
                </div>
                <br>
                <div class="form-group">
                    {{ form_label(form.confirmPassword, 'Confirmez le Mot de Passe : ', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.confirmPassword, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez votre mot de passe', 'required': 'required'}}) }}
                </div>
                <br>
                <button type="submit" class="btn-submit">Réinitialiser</button>
            {{ form_end(form) }}
        </section>
    </section>
{% endblock %}