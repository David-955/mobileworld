{% extends 'base.html.twig' %}

{% block title %}Mobile World : Mot de passe oublié ?
{% endblock %}

{% block content %}
	<section class="container-vert">
		<section class="container-blanc">
			<h1>Mot de passe oublié ?</h1>
			<p>Veuillez saisir votre adresse e-mail pour recevoir un lien de réinitialisation.</p>
            <br>
			{{ form_start(form) }}
			{{ form_widget(form) }}
            <br>
			<button type="submit" class="btn-submit">Envoyer le lien de réinitialisation</button>
			{{ form_end(form) }}
		</section>
	</section>
{% endblock %}
