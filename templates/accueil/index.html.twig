{% extends 'base.html.twig' %}

{% block title %}Mobile World : Accueil
{% endblock %}

{% block content %}
	<section class="main">
		<h1>À la une</h1>
		<ul id="news-container">
			{% for article in pagination.items %}
				<li class="news-article">
					<div class="news-image-container">
						<a href="{{ path('app_article', {'title': article.title|url_encode}) }}" target="_blank">
							<img src="{{ article.urlToImage }}" alt="{{ article.title }}" class="news-image">
						</a>
					</div>
					<div class="news-contenu">
						<a href="{{ path('app_article', {'title': article.title|url_encode}) }}" target="_blank" style="text-decoration: none;">
							<h2 class="news-title">{{ article.title }}</h2>
							<p class="news-description">{{ article.description }}</p>
						</a>
						<a href="{{ path('app_article', {'title': article.title|url_encode}) }}" target="_blank" class="news-read-more">Lire la suite...</a>
					</div>
				</li>
			{% endfor %}
		</ul>

		<div class="pagination">
			{{ knp_pagination_render(pagination) }}
		</div>
	</section>
{% endblock %}
