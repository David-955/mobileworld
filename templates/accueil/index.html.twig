{% extends 'base.html.twig' %}

{% block title %}Mobile World : Accueil{% endblock %}

{% block body %}

    <div class="accueil">
        <h1><a href="{{ path('app_accueil') }}">Mobile World</a></h1>
        <a href="{{ path('app_boutique') }}">
			<button>Boutique</button>
		</a>

        <a href="{{ path('app_login') }}">
			<button>S'inscrire</button>
		</a>

		<a href="{{ path('app_register') }}">
			<button>Se connecter</button>
		</a>


        
        <ul id="news-container">
            {% for article in pagination.items %} {# modification pour pagination #}
                <li>
                    <h2>{{ article.title }}</h2>
                    <a href="{{ path('app_article', {'title': article.title|url_encode}) }}" target="_blank">
                    <img src="{{ article.urlToImage }}" alt="{{ article.title }}" width="150px">
                    </a>
                    <p>{{ article.description }}</p>
                    <a href="{{ path('app_article', {'title': article.title|url_encode}) }}" target="_blank">Lire plus</a>
                </li>
            {% endfor %}
        </ul>

        <div class="pagination"> {# modification pour pagination #}
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
{% endblock %}


