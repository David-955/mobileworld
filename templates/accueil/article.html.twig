{% extends 'base.html.twig' %}

{% block title %}mobile World :
	{{ article.title }}
{% endblock %}

{% block content %}
	<section class="article-container">
		<section class="article-titre">
			<h1>{{ article.title }}</h1>
		</section>

		<section class="article-contenu">
			<p>
				<em>{{ article.description }}</em>
			</p>
			<img
			src="{{ article.urlToImage }}" alt="{{ article.title }}" class="article-image">

			{# Afficher le contenu complet récupéré via Diffbot #}
			<div
				class="full-content">
				{# Convertit les sauts de ligne (\n) en deux balises <br> #}
				<p>{{ article.fullContent | replace({'\n': '<br><br>'}) | raw }}</p>
			</div>

			<a href="{{ article.url }}" target="_blank">Source pour lire l'article original :
				{{ article.source.name }}
				-
				{{ article.publishedAt|date('d/m/Y H:i') }}</a>
		</section>

		<section class="container-commentaires">
			<h2>Commentaires</h2>

			{% for commentaire in pagination %}
				<section class="liste-commentaires">
					<div class="commentaires-colonne1">
						<a href="{{ path('app_profil_pseudo', {pseudo: commentaire.utilisateur.personnalisation.pseudo}) }}">
							<img src="{{ commentaire.utilisateur.personnalisation.avatar }}" alt="Avatar de {{ commentaire.utilisateur.personnalisation.pseudo }}" width="50px">
						</a>
					</div>
					<div class="commentaires-colonne2">
						<strong>Posté par
							<a href="{{ path('app_profil_pseudo', {pseudo: commentaire.utilisateur.personnalisation.pseudo}) }}">{{ commentaire.utilisateur.personnalisation.pseudo }}</a>
						</strong>, le :
						{{ commentaire.date|date('d/m/Y') }}
						à
						{{ commentaire.date|date('H:i') }}
						<p>{{ commentaire.contenu }}</p>
					</div>
				</section>
				<br>
			{% else %}
				<p><em>Aucun commentaire pour le moment.</em></p>
			{% endfor %}
			{# Affichage de la barre de pagination #}
			{{ knp_pagination_render(pagination) }}
			<br>


			{% if app.user %}
				<h2>Ajouter un commentaire</h2>

				<section class="ajout-commentaires">
					{{ form_start(form, {'attr': {'class': 'commentaire-form'}}) }}
					{{ form_label(form.contenu, 'Exprimez-vous : ', {'label_attr': {'class': 'form-label'}}) }}
					{{ form_errors(form.contenu) }} {# Affiche les erreurs spécifiques au champ #}
					{{ form_row(form.contenu, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre commentaire ici (1500 caractères maximum)', 'maxlength': 1500}}) }}
					<br>
					<button class="btn-submit" type="submit">Ajouter un commentaire</button>
					{{ form_end(form) }}
				</section>
				<br>
			{% else %}
				<p><em>Vous devez être
					<a href="{{ path('app_login') }}">connecté</a>
					pour pouvoir poster un commentaire.</em></p>
			{% endif %}
		</section>
	{% endblock %}
