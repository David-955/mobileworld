{% extends 'base.html.twig' %}

{% block title %}Mobile World : Page d'inscription{% endblock %}

{% block body %}
	<h1>
		<a href="{{ path('app_accueil') }}">Mobile World</a>
	</h1>
    <h2>Inscription</h2>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email, {
            label: 'Email'
        }) }}
        {{ form_row(registrationForm.pseudo) }}
        {# le role n'est pas là car est attribué par défaut : client #}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}
        {{ form_row(registrationForm.agreeTerms, {
            label: 'Accepter les conditions d\'utilisation'
        }) }}

        <button type="submit" class="btn">M'inscrire</button>
    
    {{ form_end(registrationForm) }}
{% endblock %}
