<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta
		charset="UTF-8">
		{# Pour tester responsive sur navigateur correctement #}
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="Mobile World - L'endroit idéal pour trouver les dernières actualités sur l'univers des appareils mobiles. Un comparateur est également à votre disposition ainsi que notre boutique possédant des accessoires divers et variés pour vous, pour offrir, pour votre maison et même pour votre voiture.">
		<title>
			{% block title %}{% endblock %}
		</title>
		<link rel="icon" href="{{ asset('/images/logos/favicon.webp') }}">

		{% block stylesheets %}
			<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
			{{ encore_entry_link_tags('app') }}
		{% endblock %}
	</head>
	<body>
		<header>
			<nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(#2dc5a9, #4caf50);">
				<div
					class="container-fluid d-flex align-items-center justify-content-between" style="width: 80%;">

					<!-- Bouton Burger Gauche -->
					<button class="navbar-toggler order-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>

					<!-- Logo Centré -->
					<a class="navbar-brand order-2 mx-auto" href="{{ path('app_accueil') }}">
						<img src="{{ asset('/images/logos/logo-mobileworld.webp') }}" alt="logo du site Mobile World" class="logo-site" style="max-height: 100px;">
					</a>

					<!-- Bouton Burger Droit -->
					<button class="navbar-toggler order-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle right navigation">
						<span class="navbar-toggler-icon"></span>
					</button>

					<!-- Menu déroulant commun -->
					<div class="collapse navbar-collapse order-4" id="navbarNav">
						<ul
							class="navbar-nav ms-auto align-items-center">

							{# Admin #}
							{% if is_granted('ROLE_ADMIN') %}
								<li class="nav-item">
									<a class="nav-link mx-auto" href="{{ path('admin') }}">Admin</a>
								</li>
							{% endif %}

							{# Pages publiques #}
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_accueil') }}">Actualités</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_comparateur') }}">Comparateur</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_boutique') }}">Boutique</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_panier') }}" aria-label="Voir le panier">
									<svg xmlns="http://www.w3.org/2000/svg" height="1.5em" viewbox="0 0 576 512" fill="currentColor" class="cart-header">
										<path d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"></path>
									</svg>
								</a>
							</li>

							{# Connexion / Inscription #}
							{% if not app.user %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_register') }}">S'inscrire</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_login') }}">Se connecter</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_profil') }}">
										<img src="{{ asset(app.user.personnalisation.avatar) }}" alt="Image de profil" class="profile-image-header" style="max-height: 50px; border-radius: 50%;">
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
								</li>
							{% endif %}
						</ul>
					</div>

				</div>
			</nav>
		</header>

		<main>
			{# Bloc pour le contenu principal #}
			{% block content %}{% endblock %}
			<!-- From Uiverse.io by vinodjangid07 -->
			<button class="Btn-retourhaut" aria-label="Retour vers le haut">
				<svg height="1.2em" class="arrow" viewbox="0 0 512 512">
					<path d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z"></path>
				</svg>
			</button>
		</main>

		<footer>
			<section class="footer-liens">
				<a href="{{ path('app_contact') }}" class="nav-link">Nous contacter</a>
				<a href="{{ path('app_mentions') }}" target="_blank" class="nav-link">Mentions légales</a>
				<a href="https://www.iubenda.com/privacy-policy/79901867" target="_blank" class="nav-link">Politique de confidentialité</a>
				<a href="https://www.iubenda.com/privacy-policy/79901867/cookie-policy" target="_blank" class="nav-link">Politique Cookies</a>
			</section>

			{# Réseaux Sociaux #}
			{# https://uiverse.io/david-mohseni/brave-shrimp-86 #}
			<ul class="wrapper">
				<li class="icon facebook">
					<span class="tooltip">Facebook</span>
					<a href="https://www.facebook.com/" target="_blank" aria-label="Visiter notre page Facebook">
						<svg viewbox="0 0 320 512" height="1.2em" xmlns="http://www.w3.org/2000/svg">
							<path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"></path>
						</svg>
					</a>
				</li>

				<li class="icon twitter">
					<span class="tooltip">X</span>
					<a href="https://www.x.com/" target="_blank" aria-label="Visiter notre page X.com">
						<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 512 512" height="1.2em"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
					</a>
				</li>

				<li class="icon instagram">
					<span class="tooltip">Instagram</span>
					<a href="https://www.instagram.com/" target="_blank" aria-label="Visiter notre page Instagram">
						<svg xmlns="http://www.w3.org/2000/svg" height="1.2em" viewbox="0 0 16 16">
							<path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"></path>
						</svg>
					</a>
				</li>
			</ul>

			<p>Mobile World ©
				{{ "now"|date("Y") }}
				- tous droits réservés</p>

		</footer>

	</body>
	{# termly.io #}
	<script src="https://app.termly.io/resource-blocker/0bc8682a-b2a9-4367-a622-f8b75b26d230?autoBlock=on"></script>
	{# bootstrap #}
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	{{ encore_entry_script_tags('app') }}
</html>
