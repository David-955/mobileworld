{% extends 'base.html.twig' %}
{% block title %}Mobile World : Mon panier
{% endblock %}
{% block content %}
	<h1>Mon panier</h1>
	<section class="container-vert">
		<section class="container-blanc">

			{% if panier|length > 0 %}
				<table class="table">
					<thead>
						<tr>
							<th></th>
							<th>Désignation</th>
							<th>Quantité</th>
							<th>Prix</th>
							<th>Sous-total</th>
						</tr>
					</thead>
					<tbody>
						{% for item in panier %}
							<tr>
								<td><img src="{{ asset('images/produits/' ~ item.product.image) }}" alt="Image de {{ item.product.nom }}" class="zoomable-image" data-modal="image-modal" style="width : 100px; border-radius: 8px;"></td>
								<td data-label="Nom du produit: ">
									{{ item.product.nom }}</td>
								<td data-label="Quantité: ">
									<div class="quantite-container">
										{% if item.quantity > 1 %}
											<a href="{{ path('app_panier_modifier', {'id': item.product.id, 'action': 'moins'}) }}">
												<button class="btn-moins">-</button>
											</a>
										{% else %}
											<a href="{{ path('app_panier_supprimer', {'id': item.product.id}) }}">
												<button
													aria-label="supprimer" class="delete-button">
													{# source : https://uiverse.io/philipo30/afraid-ape-40  #}
													<svg class="trash-svg" viewbox="0 -10 64 74" xmlns="http://www.w3.org/2000/svg">
														<g id="trash-can">
															<rect x="16" y="24" width="32" height="30" rx="3" ry="3" fill="#e74c3c"></rect>
															<g transform-origin="12 18" id="lid-group">
																<rect x="12" y="12" width="40" height="6" rx="2" ry="2" fill="#c0392b"></rect>
																<rect x="26" y="8" width="12" height="4" rx="2" ry="2" fill="#c0392b"></rect>
															</g>
														</g>
													</svg>
												</button>
											</a>
										{% endif %}
										<input type="number" class="quantite-input" value="{{ item.quantity }}" min="1" max="{{ item.product.stock }}" readonly/>
										<a href="{{ path('app_panier_modifier', {'id': item.product.id, 'action': 'plus'}) }}">
											<button class="btn-plus">+</button>
										</a>
									</div>
								</td>
								<td data-label="Prix unitaire:">
									{{ item.product.prix }}€</td>
								<td data-label="Total:">
									{{ item.total }}€</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				<p>
					<em>Vider le panier</em>
					<a href="{{ path('app_cancel') }}">
						<button aria-label="supprimer" class="delete-button">
							<svg class="trash-svg" viewbox="0 -10 64 74" xmlns="http://www.w3.org/2000/svg">
								<g id="trash-can">
									<rect x="16" y="24" width="32" height="30" rx="3" ry="3" fill="#e74c3c"></rect>
									<g transform-origin="12 18" id="lid-group">
										<rect x="12" y="12" width="40" height="6" rx="2" ry="2" fill="#c0392b"></rect>
										<rect x="26" y="8" width="12" height="4" rx="2" ry="2" fill="#c0392b"></rect>
									</g>
								</g>
							</svg>
						</button>
					</a>
				</p>
				<p>La livraison est
					<strong>offerte</strong>
					pour toute commande pour fêter l'ouverture de notre site !</p>

				<p class="panier-total">
					<strong>Montant total TTC :
						{{ total }}€
					</strong>
				</p>
			{% else %}
				<p class="panier-total">Votre panier est vide.</p>
			{% endif %}

			<div class="boutons-action">
				{% if panier|length > 0 %}

					<button class="CartBtn">
						<span
							class="IconContainer">
							{# https://www.svgrepo.com/svg/487782/shopping-bags #}
							<svg fill="#ffffff" viewbox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg">
								<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
								<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
								<g id="SVGRepo_iconCarrier">
									<path d="M21,12H18.335L18,6.934A1,1,0,0,0,17,6H15A5,5,0,0,0,5,6H3a1,1,0,0,0-1,.934l-1,15A1,1,0,0,0,2,23H22a1,1,0,0,0,.994-1.11l-1-9A1,1,0,0,0,21,12ZM10,3a3,3,0,0,1,3,3H7A3,3,0,0,1,10,3ZM3.069,21,3.935,8H5v2a1,1,0,0,0,2,0V8h6v2a1,1,0,0,0,2,0V8h1.064l.867,13Zm15.866,0-.466-7h1.636l.778,7Z"></path>
								</g>
							</svg>
						</span>
						<a href="{{ path('app_boutique') }}" class="text">Go faire des achats</a>
					</button>

					<button class="CartBtn">
						<span
							class="IconContainer">
							{# https://www.svgrepo.com/svg/447841/wallet?edit=true #}
							<svg viewbox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" stroke-width="3" stroke="#ffffff" fill="none">
								<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
								<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
								<g id="SVGRepo_iconCarrier">
									<path d="M53.36,41.21V52.14a2,2,0,0,1-2,2h-43a2,2,0,0,1-2-2v-31a2,2,0,0,1,2-2h43a2,2,0,0,1,2,2v8.93" stroke-linecap="round"></path>
									<rect x="39.64" y="30.07" width="18" height="11.14" rx=".99" stroke-linecap="round"></rect>
									<path d="M8.14,19.14l33.15-9.2h0a1.7,1.7,0,0,1,2.15,1.6l.27,7" stroke-linecap="round"></path>
									<line x1="45.73" y1="35.64" x2="46.26" y2="35.64" stroke-linecap="round"></line>
								</g>
							</svg>
						</span>
						<a href="{{ path('app_commande') }}" class="text">Commander !</a>
					</button>
				{% else %}
					<button class="CartBtn">
						<span
							class="IconContainer">
							{# https://www.svgrepo.com/svg/487782/shopping-bags #}
							<svg fill="#ffffff" viewbox="-2.4 -2.4 28.80 28.80" xmlns="http://www.w3.org/2000/svg">
								<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
								<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
								<g id="SVGRepo_iconCarrier">
									<path d="M21,12H18.335L18,6.934A1,1,0,0,0,17,6H15A5,5,0,0,0,5,6H3a1,1,0,0,0-1,.934l-1,15A1,1,0,0,0,2,23H22a1,1,0,0,0,.994-1.11l-1-9A1,1,0,0,0,21,12ZM10,3a3,3,0,0,1,3,3H7A3,3,0,0,1,10,3ZM3.069,21,3.935,8H5v2a1,1,0,0,0,2,0V8h6v2a1,1,0,0,0,2,0V8h1.064l.867,13Zm15.866,0-.466-7h1.636l.778,7Z"></path>
								</g>
							</svg>
						</span>
						<a href="{{ path('app_boutique') }}" class="text">Go faire des achats</a>
					</button>
				{% endif %}
			</div>

			<br>
			{% if panier|length > 0 %}
				<small class="required-note">{{ "Prix TTC, TVA appliquée sur la base du pays : France (métropolitaine)" }}</small>
			{% endif %}
		</section>
	</section>

	<div id="image-modal" class="modal">
		<span class="close">&times;</span>
		{# class pour css, id pour js #}
		<img class="modal-content" id="modal-image">
	</div>
{% endblock %}
