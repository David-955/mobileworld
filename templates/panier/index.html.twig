{% extends 'base.html.twig' %}

{% block title %}Mobile World : Panier
{% endblock %}

{% block content %}
	<h1>Panier</h1>

	{% if cart|length > 0 %}
		<section class="panier-container-vert">
			<section class="panier-container-blanc">
				<table class="table">
					<thead>
						<tr>
							<th>Image du produit</th>
							<th>Nom du produit</th>
							<th>Quantité</th>
							<th>Prix unitaire</th>
							<th>Total</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						{% for item in cart %}
							<tr>
								<td><img src="{{ asset('images/produits/' ~ item.product.image) }}" class="panier-img" alt="Image de {{ item.product.nom }}"></td>
								<td data-label="Nom du produit: "> {{ item.product.nom }}</td>
								<td data-label="Quantité: ">
									<form action="{{ path('app_panier_modifier', {'id': item.product.id}) }}" method="post">
										<input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="{{ item.product.stock }}">
										<button type="submit" class="btn btn-sm btn-primary">Mettre à jour</button>
									</form>
								</td>
								<td data-label="Prix unitaire:"> {{ item.product.prix }}€</td>
								<td data-label="Total:"> {{ item.total }}€</td>
								<td data-label="Action:">
									<a href="{{ path('app_panier_supprimer', {'id': item.product.id}) }}" class="btn btn-sm btn-danger">Supprimer</a>
								</td>
							</tr>
						{% endfor %}

					</tbody>
				</table>

				<p class="panier-total">
					<strong>Montant total TTC :
						{{ total }}€
					</strong>
				</p>
			{% else %}
			{# réutilisation de panier-total pour centrer #}
				<p class="panier-total">Votre panier est vide.</p>
			{% endif %}
			<div
				class="boutons-action">
				{# Bouton pour continuer les achats #}
				<a href="{{ path('app_boutique') }}" class="btn-continuer">Continuer les achats</a>

				{# Bouton pour passer à la commande #}
				<a href="{{ path('app_commande') }}" class="btn-commander">Commander</a>
			</div>
		</section>
	</section>


{% endblock %}
