{% extends 'base.html.twig' %}

{% block title %}Mobile World : Boutique{% endblock %}

{% block body %}
    <h1><a href="{{ path('app_accueil') }}">Mobile World</a></h1>
    <h2 style="text-align: center;">Bienvenue sur ma boutique</h2>

    {% for categories in categories_boutique %}
        <a href= "{{ path('app_produit', {'alias': categories.alias}) }}"> <img src="{{ categories.image }}" alt="{{ categories.nom }}" width="150px"></a>
        <p>{{categories.nom}}</p>
    {% endfor %}
{% endblock %}

