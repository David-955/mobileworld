{% extends 'base.html.twig' %}

{% block title %}Mobile World : Boutique{% endblock %}

{% block content %}
    <h1 style="text-align: center;">Bienvenue sur ma boutique</h1>

    {% for categorie in categories %}
        <a href= "{{ path('app_categorie', { 'id': categorie.id }) }}"> <img src="{{ asset('images/categories/' ~ categorie.image) }}" alt="{{ categorie.nom }}" width="150px"></a>
        <p>{{categorie.nom}}</p>
    {% endfor %}
{% endblock %}

