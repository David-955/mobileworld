{% extends 'base.html.twig' %}

{% block title %}Mobile World : Boutique{% endblock %}

{% block content %}
    <h1 style="text-align: center;">Bienvenue sur notre boutique !</h1>
    {# 1er border-radius #}
    <section class="category-container-vert">
    {# 2eme border-radius #}
        <section class="category-container-blanc">
            {% for categorie in categories %}
                <div class="category-item">
                    <a href="{{ path('app_categorie', { 'id': categorie.id }) }}">
                        <img src="{{ asset('images/categories/' ~ categorie.image) }}" alt="{{ categorie.nom }}">
                    </a>
                    <p>{{ categorie.nom }}</p>
                </div>
            {% endfor %}
        </section>
    </section>
{% endblock %}

