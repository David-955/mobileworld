{% extends 'base.html.twig' %}

{% block title %}Boutique : {{ category.nom }}{% endblock %}

{% block body %}
    <h1>
        <a href="{{ path('app_accueil') }}">Mobile World</a>
    </h1>
    <h2 style="text-align: center;">Boutique : {{ category.nom }}</h2>
    {% for product in products %}
        <div>
            <p>{{ product.nom }}</p>
            {# chemin d'accès de l'image /public/images/produits #}
            <img src="{{ asset('images/produits/' ~ product.image) }}" alt="{{ product.nom }}">
            <p>{{ product.description }}</p>
            <p>{{ product.prix }}€</p>
            <p>Encore {{ product.stock }} en stock !</p>
            <a href="{{ path('app_panier_ajouter', {'id': product.id}) }}" class="btn btn-primary">Ajouter au panier</a>
        </div>
        <br>
    {% endfor %}
    <br><br>
    <a href="{{ path('app_boutique') }}">Revenir à la boutique</a>
{% endblock %}