{% extends 'base.html.twig' %}

{% block title %}
	Boutique :
	{{ category.nom }}
{% endblock %}

{% block content %}
	<h1>Boutique :
		{{ category.nom }}</h1>
	<section class="container-vert">
		<section class="product-container-blanc">
			{# Conteneur pour le fil d'Ariane, la recherche et le tri #}

			{# fil d'Ariane #}
				<p class="ariane"> <a href="{{ path('app_boutique') }}">Boutique</a>
				>
				{{ category.nom }}
			</p>
			<div
				class="search-sort">
				{# Formulaire de recherche #}
				<form method="GET" action="{{ path('app_categorie', {'id': category.id}) }}" class="search-form form-inline">
					<input class="" style="border-radius: 8px;" type="text" name="search" placeholder="Rechercher un produit..." value="{{ search }}">
					<button class="btn-search" type="submit" style="border-radius: 8px; background-color: #f4f4f9;">
						{# https://www.svgrepo.com/svg/16890/loupe #}
						<svg fill="#000000" height="20px" width="15px" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512 512" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <g> <path d="M270.566,104.909c-3.337-3.337-8.73-3.337-12.066,0c-3.336,3.336-3.336,8.73,0,12.066l34.133,34.133 c1.664,1.664,3.849,2.5,6.033,2.5c2.185,0,4.369-0.836,6.033-2.5c3.336-3.337,3.336-8.73,0-12.066L270.566,104.909z"></path> <path d="M219.366,121.975c-3.336-3.337-8.73-3.337-12.066,0s-3.337,8.73,0,12.066l68.267,68.267c1.664,1.664,3.849,2.5,6.033,2.5 c2.185,0,4.369-0.836,6.033-2.5c3.336-3.337,3.336-8.73,0-12.066L219.366,121.975z"></path> <path d="M366.481,330.291l37.939,37.939c1.664,1.673,3.849,2.5,6.033,2.5c2.176,0,4.361-0.828,6.033-2.5 c3.328-3.328,3.328-8.73,0-12.066l-39.962-39.962c20.881-32.094,33.075-70.332,33.075-111.394 c0-112.922-91.878-204.8-204.8-204.8S0,91.887,0,204.809s91.878,204.8,204.8,204.8 C270.464,409.609,328.977,378.505,366.481,330.291z M204.8,392.542c-103.518,0-187.733-84.215-187.733-187.733 S101.282,17.075,204.8,17.075s187.733,84.215,187.733,187.733S308.318,392.542,204.8,392.542z"></path> <path d="M204.8,34.142c-94.106,0-170.667,76.561-170.667,170.667S110.694,375.475,204.8,375.475s170.667-76.561,170.667-170.667 S298.906,34.142,204.8,34.142z M204.8,358.409c-84.693,0-153.6-68.907-153.6-153.6s68.907-153.6,153.6-153.6 s153.6,68.907,153.6,153.6S289.493,358.409,204.8,358.409z"></path> <path d="M499.499,439.177l-59.802-59.793c-1.596-1.604-3.763-2.5-6.033-2.5h-0.008c-2.261,0-4.437,0.905-6.042,2.517 l-24.064,24.192c-3.328,3.345-3.311,8.738,0.034,12.066c3.345,3.328,8.747,3.319,12.066-0.034l18.031-18.125l53.751,53.743 c4.83,4.838,7.501,11.264,7.501,18.108c0,6.827-2.671,13.261-7.501,18.091c-9.975,9.975-26.206,9.992-36.198,0.009 l-101.12-101.12c-3.328-3.328-8.73-3.328-12.066,0c-3.328,3.337-3.328,8.738,0,12.075l101.12,101.111 c8.311,8.32,19.234,12.476,30.157,12.476s21.862-4.164,30.174-12.476C507.554,491.452,512,480.742,512,469.35 C512,457.95,507.554,447.232,499.499,439.177z"></path> </g> </g> </g> </g></svg>
					</button>
				</form>

				{# Menu de tri #}
				<form method="GET" action="{{ path('app_categorie', {'id': category.id}) }}" class="sort-form">
					<label for="sort-order">Trier par :</label>
					<select name="sort" id="sort-order" onchange="this.form.submit()">
						<option value="price_asc" {% if sort == 'price_asc' %} selected {% endif %}>Prix croissant</option>
						<option value="price_desc" {% if sort == 'price_desc' %} selected {% endif %}>Prix décroissant</option>
					</select>
					{# Conserver la recherche lors du tri #}
					<input type="hidden" name="search" value="{{ search }}">
				</form>
			</div>

			{% for product in pagination %}
				{# affichage que des produits avec du stock #}
				{% if product.stock > 0 %}
					<div
						class="product-item">
						{# colonne 1: image #}
						<div class="product-colonne1">
							<img src="{{ asset('images/produits/' ~ product.image) }}" alt="{{ product.nom }}" class="zoomable-image" data-modal="image-modal"></div>
						{# colonne 2: nom et description #}
						<div class="product-colonne2">
							<p>
								<strong>{{ product.nom }}</strong>
							</p>
							<p>{{ product.description }}</p>
						</div>
						{# colonne 3: prix, stock et ajout panier #}
						<div class="product-colonne3">
							<p>
								<strong>Prix :
									{{ product.prix }}€</strong>
							</p>
							<p>Stock :
								{{ product.stock }}</p>
							<button class="CartBtn">
								<span class="IconContainer">
									<svg xmlns="http://www.w3.org/2000/svg" height="1em" viewbox="0 0 576 512" fill="#fff" class="cart">
										<path d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"></path>
									</svg>
								</span>
								<a href="{{ path('app_panier_ajouter', {'id': product.id}) }}" class="text">Ajouter au panier</a>
							</button>
						</div>
					</div>
				{% endif %}
			{% else %}
				<p>Aucun produit disponible dans cette catégorie.</p>
			{% endfor %}
			<div
				class="container-pagination">
				{# Affichage de la barre de pagination #}
				{{ knp_pagination_render(pagination) }}
				<p style="margin-top: 30px">
					<a href="{{ path('app_boutique') }}" class="btn-submit">Revenir à la boutique</a>
				</p>
			</div>
		</section>
	</section>

	<div id="image-modal" class="modal">
		<span class="close">&times;</span>
		{# class pour css, id pour js #}
		<img class="modal-content" id="modal-image">
	</div>
{% endblock %}
